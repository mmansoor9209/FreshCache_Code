# run_retrieval_correction.log  executed 2026-09-24; script (verbatim) followed by output
# rule: rows of one question sorted by retrieval_timestamp; a new call starts when the gap to the previous row exceeds 120 s
# --- script ---
import sys,collections,datetime as dt; sys.path.insert(0,'.'); import experiment as exp
m=exp.load_jsonl(exp.MANIFEST_FILE); q=exp.load_jsonl(exp.QUERIES_FILE); pa=exp.load_jsonl(exp.PARAPHRASE_FILE)
records=exp.build_query_records(q,m,pa); retained={r['query_id'] for r in records if not r['is_paraphrase']}
per=collections.defaultdict(list)
for x in m:
    if x.get('run_id')=='run_00': per[x['query_id']].append(x)
def calls(rows,gap=120):
    rows=sorted(rows,key=lambda x:x['retrieval_timestamp']); out=[]; last=None
    for x in rows:
        t=dt.datetime.fromisoformat(x['retrieval_timestamp'])
        if last is None or (t-last).total_seconds()>gap: out.append([x])
        else: out[-1].append(x)
        last=t
    return out
